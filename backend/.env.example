# KocaMind Backend ortam degiskenleri sablonu
# Gercek anahtarlari yalnizca yerel .env dosyaniza veya Vercel ortam ayarlarina yazin.

# Firebase (FIREBASE_SERVICE_ACCOUNT veya Application Default Credentials)
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_PROJECT_ID=kocamind
FIREBASE_STORAGE_BUCKET=kocamind.firebasestorage.app

# Model Saglayicilari (en az OPENAI_API_KEY veya DEEPSEEK_API_KEY gerekir)
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
EVREN_LLM_API_KEY=
GEMINI_API_KEY=
GEMINI_CHAT_ENABLED=false
GROQ_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=

# Arama ve RAG
TAVILY_API_KEY=
QDRANT_URL=http://localhost:6333

# Sunucu ve CORS
PORT=3001
ALLOWED_ORIGINS=https://kocamind.com,https://www.kocamind.com,http://localhost:5173,http://127.0.0.1:5173

# Cron, E-posta ve Uyarilar
CRON_SECRET=
RESEND_API_KEY=
ALERT_WEBHOOK_URL=
ALERT_ERROR_RATE=0.2
ALERT_MIN_CALLS=20
ALERT_AVG_LATENCY_MS=30000
ALERT_CLIENT_ERRORS=50
ALERT_CLIENT_ERROR_SPIKE=20

# Faturalama (iyzico)
IYZICO_MODE=sandbox
IYZICO_BASE_URL=
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_MERCHANT_ID=
IYZICO_PRICING_PLAN_REFERENCE_CODE=
BILLING_SETUP_TOKEN=
PUBLIC_BACKEND_URL=https://api.kocamind.com
PUBLIC_FRONTEND_URL=https://kocamind.com

# Baglayicilar ve Diger Ozellikler
CONNECTOR_TOKEN_KEY=
MODEL_PRICING_JSON=
AUTO_ROUTER_MODELS=
AUTO_ROUTER_COST_WEIGHT=
JAILBREAK_GUARD=on
IDE_MODELS=
MEMORY_SERVER_LEARN=false
GMAIL_USER=
GMAIL_APP_PASSWORD=
