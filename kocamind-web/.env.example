# KocaMind Web ortam degiskenleri sablonu
# Yerel gelistirme icin .env.local olarak kopyalayin.

VITE_BACKEND_URL=http://localhost:3001

# Firebase Web SDK (tanimlanmazsa kocamind-web/src/lib/firebase.js varsayilanlari kullanilir)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Opsiyonel ozellikler
VITE_GOOGLE_OAUTH_CLIENT_ID=
VITE_USE_FIREBASE_EMULATOR=
