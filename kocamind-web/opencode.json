{
  "$schema": "https://opencode.ai/config.json",
  "username": "tyler",
  "shell": "powershell",
  "permission": {
    "edit": "allow",
    "bash": {
      "npm *": "allow",
      "vercel *": "allow",
      "git *": "allow",
      "npx *": "allow",
      "*": "ask"
    },
    "external_directory": {
      "~/Desktop/kocamind/**": "allow",
      "~/AppData/Local/Temp/opencode/**": "allow",
      "*": "ask"
    }
  },
  "instructions": [
    "AGENTS.md"
  ],
  "references": {
    "backend": {
      "path": "../backend",
      "description": "KocaMind Express backend (API proxy, RAG, tools, memory)"
    },
    "android": {
      "path": "../kocamind-android",
      "description": "KocaMind Android app (Kotlin + Jetpack Compose)",
      "hidden": true
    }
  }
}
