<?xml version="1.0" encoding="utf-8"?>
<!-- Açılış ekranı: beyaz zeminsiz KocaMind işareti, dört nokta merkez etrafında döner. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="108dp" android:height="108dp"
            android:viewportWidth="108" android:viewportHeight="108">
            <group android:name="dots" android:pivotX="54" android:pivotY="54">
                <path android:fillColor="@color/splashBrand" android:pathData="M48.50,41.17a5.50,5.50 0 1,0 11.00,0a5.50,5.50 0 1,0 -11.00,0Z"/>
                <path android:fillColor="@color/splashDot" android:pathData="M61.33,54.00a5.50,5.50 0 1,0 11.00,0a5.50,5.50 0 1,0 -11.00,0Z"/>
                <path android:fillColor="@color/splashDot" android:pathData="M48.50,66.83a5.50,5.50 0 1,0 11.00,0a5.50,5.50 0 1,0 -11.00,0Z"/>
                <path android:fillColor="@color/splashDot" android:pathData="M35.67,54.00a5.50,5.50 0 1,0 11.00,0a5.50,5.50 0 1,0 -11.00,0Z"/>
            </group>
        </vector>
    </aapt:attr>
    <target android:name="dots">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="rotation"
                android:valueFrom="0"
                android:valueTo="360"
                android:duration="1100"
                android:repeatCount="infinite"
                android:interpolator="@android:interpolator/fast_out_slow_in"/>
        </aapt:attr>
    </target>
</animated-vector>
